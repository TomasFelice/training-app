# Creá tu clave en https://aistudio.google.com/api-keys
VITE_GEMINI_API_KEY=

# Modelo con cuota gratuita de la API (Google AI Pro se gestiona por separado).
# La cuota depende del proyecto en AI Studio; un proyecto con billing paga por uso.
VITE_GEMINI_MODEL=gemini-3.8-flash

# Alternativa automática ante saturación del principal, también con cuota gratuita.
# Dejá el valor vacío para desactivar el fallback. Ambos usan razonamiento medio.
VITE_GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
